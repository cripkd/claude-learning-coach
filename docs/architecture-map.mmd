  classDef front fill:#243b53,stroke:#5b9bd5,color:#fff,stroke-width:2px
  classDef elec fill:#3a2f1f,stroke:#d0a050,color:#fff,stroke-width:2px
  classDef srv fill:#2b2b4d,stroke:#8888dd,color:#fff,stroke-width:2px
  classDef coach fill:#3a2b4d,stroke:#b088dd,color:#fff,stroke-width:2px
  classDef script fill:#3d2b1f,stroke:#cc7777,color:#fff,stroke-width:2px
  classDef hook fill:#3a1f3a,stroke:#cc77cc,color:#fff,stroke-width:2px
  classDef file fill:#1f3a2b,stroke:#77cc99,color:#fff,stroke-width:2px
  classDef dash fill:#4d3a1f,stroke:#ddaa55,color:#fff,stroke-width:2px
  class U user
  class F_TERM,F_WEB,F_APP front
  class E1,E2,E3,E4 elec
  class SV1,SV2 srv
  class COACH coach
  class N1,N2,N3,N4 script
  class H1,H2,H3 hook
  class R1,R2,R3 file
  class DASH dash
