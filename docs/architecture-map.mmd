flowchart TB
  U["👤 Student"]

  %% ── Three front doors, one coach ────────────────────────────────
  subgraph FRONT["🖥 Three front doors — same coach underneath"]
    direction LR
    F_TERM["Terminal<br/>claude CLI"]
    F_WEB["Web<br/>npm run web"]
    F_APP["Desktop<br/>Electron (.app)"]
  end

  %% ── Electron wrapper internals ──────────────────────────────────
  subgraph ELEC["📦 Electron wrapper (desktop/main.cjs)"]
    direction TB
    E1["resolveRoots()<br/>bundle / data / cache"]
    E2["seedWorkspace()<br/>rewrite CLAUDE.md + .claude/ from bundle"]
    E3["resolveClaudeBin()<br/>bundled per-platform claude binary"]
    E4["fork(web/server.mjs)<br/>Electron-as-Node · loopback port"]
    E1 --> E2 --> E3 --> E4
  end

  %% ── Server + coach engine ───────────────────────────────────────
  subgraph SRV["🌐 web/server.mjs (SSE ↔ browser)"]
    direction TB
    SV1["auth: claude auth status/login<br/>subscription login · no API key"]
    SV2["query() — Agent SDK<br/>drives the claude binary"]
  end

  COACH["🧠 Coach turn (LLM)<br/>reads CLAUDE.md · picks Read/Write/Bash<br/>teaches · quizzes · records"]

  %% ── Deterministic node scripts ──────────────────────────────────
  subgraph SCRIPTS["⚙️ Node scripts (deterministic — no LLM)"]
    direction TB
    N1["build-dashboard.mjs<br/>migrate · validate · compute · render"]
    N2["build-embeddings.mjs<br/>sources → vectors"]
    N3["retrieve.mjs<br/>vector query (top-K, domain-aware)"]
    N4["check-day-readiness.mjs<br/>required-reads coverage"]
  end

  %% ── Hooks ───────────────────────────────────────────────────────
  subgraph HOOKS["🪝 Hooks (.claude/settings.json — auto-fire)"]
    direction TB
    H1["PostToolUse · on state.json write"]
    H2["PostToolUse · on sources/ or bank/ write"]
    H3["Stop · on turn-end (can block)"]
  end

  %% ── Files across three storage roots ────────────────────────────
  subgraph ROOTS["📁 Storage roots (scripts/_roots.mjs)"]
    direction TB
    R1["BUNDLE_ROOT · read-only<br/>code · templates/ · starter-files/<br/>_index.md · embeddings.ndjson"]
    R2["DATA_ROOT · writable (userData/workspace)<br/>SOURCES.md · sources/ · bank/ · memory · progress<br/>misses · calibration · quizzes · state.json ⭐"]
    R3["CACHE_ROOT · disposable<br/>embedding model cache"]
  end

  DASH["📊 dashboard/index.html<br/>build artifact · live-reload via SSE"]

  %% ── Wiring ───────────────────────────────────────────────────────
  U --> FRONT
  F_APP --> ELEC
  E4 --> SRV
  F_WEB --> SRV
  F_TERM --> COACH
  SV1 -. gates .-> COACH
  SV2 --> COACH

  COACH -->|reads via| N3 --> R1
  COACH -->|reads/writes| R2
  COACH -. or reads index/direct .-> R1

  R2 -->|state.json write| H1 --> N1 --> DASH
  R2 -->|sources/ write| H2 --> N2 --> R1
  N2 -.model cache.-> R3
  COACH -->|turn-end| H3 --> N4
  H3 -. reads .-> R1

  DASH --> U

